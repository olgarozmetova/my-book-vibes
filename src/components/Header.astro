---
interface Props {
  current?: "home" | "books" | "about"
}

const { current } = Astro.props

const links = [
  { href: "/", id: "home", label: "Inicio" },
  { href: "/books", id: "books", label: "Libros" },
  { href: "/about", id: "about", label: "Sobre mí" },
] as const;
---

<header class="bg-canvas">
  <div class="mx-auto flex h-20 w-full max-w-300 items-center justify-between gap-4 px-5 sm:h-28">
    <a href="/" class="font-display text-xl font-semibold tracking-[-0.03em] transition-colors hover:text-blush sm:text-3xl">
      MyBookVibes
    </a>
    <nav class="flex items-center gap-4 sm:gap-7" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={current === link.id ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-paper",
              current === link.id
                ? "font-serif text-base font-medium text-paper sm:text-xl"
                : "text-sm font-semibold text-muted sm:text-lg",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a href="/about" class="group hidden items-center gap-4 md:flex">
      <div class="text-right">
        <small class="block text-sm tracking-[0.08em] text-muted">RESEÑAS DE</small>
        <strong class="font-display text-2xl font-semibold transition-colors group-hover:text-blush">Elena</strong>
      </div>
      <img src="/portraits/elena.jpg" alt="" width="80" height="80" class="size-20 rounded-full object-cover object-[68%_30%]" />
    </a>
  </div>
</header>

