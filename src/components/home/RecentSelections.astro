---
import TextLink from "../TextLink.astro"
import { formatScore, scoreTone, type Book } from "../../data/books"

interface Props {
  books: Book[]
}

const { books } = Astro.props

const toneClass = {
  hot: "text-coral",
  warm: "text-gold",
  cool: "text-lilac",
}
---

<div class="mt-12 mb-4 flex flex-col gap-1 text-[11px] tracking-[0.08em] text-muted sm:flex-row sm:items-center sm:justify-between">
  <span><b class="font-semibold text-coral">02</b> / SELECCIONES RECIENTES</span>
  <span>Tres dictámenes esenciales</span>
</div>
<div class="flex flex-col">
  {
    books.map((book) => (
      <a
        href={`/books/${book.slug}`}
        class="grid grid-cols-[4.5rem_1fr] items-center gap-4 border-b border-line py-4.5 text-left transition-transform hover:-translate-y-0.5 hover:bg-lift sm:grid-cols-[5.5rem_1fr_7.5rem] sm:gap-6"
      >
        <div class:list={["text-[1.75rem] leading-none font-bold", toneClass[scoreTone(book.score)]]}>
          {formatScore(book.score)}
        </div>
        <div>
          <strong class="block font-display text-xl">{book.title}</strong>
          <em class="text-[13px] text-muted not-italic">{book.author}</em>
          <p class="mt-1 font-serif text-[17px] leading-snug text-muted">{book.homeBlurb}</p>
        </div>
        <span class="hidden text-[11px] font-medium tracking-[0.08em] sm:block">FICHA RÁPIDA</span>
      </a>
    ))
  }
</div>
<p class="mt-6">
  <TextLink href="/books">Ver todos los libros</TextLink>
</p>
