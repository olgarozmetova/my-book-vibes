---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/home/Hero.astro"
import FeaturedVerdict from "../components/home/FeaturedVerdict.astro"
import RecentSelections from "../components/home/RecentSelections.astro"
import { books } from "../data/books"

const featured = books.find((book) => book.featured)
const recent = books
  .filter((book) => book.homeOrder != null)
  .sort((a, b) => (a.homeOrder ?? 0) - (b.homeOrder ?? 0))

---

<BaseLayout title="MyBookVibes" current="home">
  <Hero />
  {featured && <FeaturedVerdict book={featured} />}
  <RecentSelections books={recent} />
  
</BaseLayout>
