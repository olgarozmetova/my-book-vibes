---
import BaseLayout from "../layouts/BaseLayout.astro"
import TextLink from "../components/TextLink.astro"
import Dispatch from "../components/home/Dispatch.astro"

const scale = [
  { range: "9.0 – 10", title: "Desvelo obligatorio", text: "Libros que te cambian la forma de leer. Los termino y los reviso de nuevo al día siguiente.", tone: "text-coral" },
  { range: "8.5 – 8.9", title: "Muy recomendable", text: "Sólidos y memorables, con algún tropiezo que no les quita el pulso.", tone: "text-blush" },
  { range: "7.0 – 8.4", title: "Con reservas", text: "Tienen una gran idea o una gran escena, pero el conjunto no termina de sostenerse.", tone: "text-muted" },
]
---

<BaseLayout title="Sobre mí · MyBookVibes" current="about">
  <section class="grid items-center gap-10 md:grid-cols-[1.2fr_0.8fr] md:gap-14">
    <div>
      <p class="flex items-center gap-2 text-[11px] font-medium tracking-[0.12em] text-muted">
        <i class="inline-block size-1.5 bg-coral"></i>
        MANIFIESTO · ELENA
      </p>
      <h1 class="mt-4.5 font-display text-4xl leading-[1.08] font-extrabold tracking-[-0.03em] sm:text-5xl">
        Leo de noche para que tú elijas <span class="font-serif font-normal text-blush">mejor</span>.
      </h1>
      <div class="mt-6 max-w-150 space-y-4 font-serif text-lg leading-[1.55] text-muted">
        <p>
          Soy Elena, lectora voraz y crítica independiente. MyBookVibes nació de una frustración simple: demasiadas reseñas
          que elogian todo y no dicen nada.
        </p>
        <p>
          Aquí encontrarás calificaciones del 1 al 10, una síntesis sin rodeos y los puntos flojos de cada libro, para que
          decidas en tres minutos si merece tu próximo desvelo.
        </p>
      </div>
      <p class="mt-6">
        <TextLink href="/books">Explorar el archivo completo</TextLink>
      </p>
    </div>
    <img
      src="/portraits/elena.jpg"
      alt="Elena leyendo un libro"
      width="512"
      height="279"
      class="aspect-4/5 w-full max-w-sm bg-surface object-cover object-[68%_30%] md:justify-self-end"
    />
  </section>

  <section class="mt-14">
    <p class="mb-4 text-[11px] tracking-[0.08em] text-muted">
      <b class="font-semibold text-coral">01</b> / CÓMO CALIFICO
    </p>
    <div class="grid gap-px bg-line md:grid-cols-3">
      {
        scale.map((item) => (
          <article class="bg-card p-6">
            <p class:list={["text-4xl leading-none font-bold", item.tone]}>{item.range}</p>
            <h2 class="mt-3 font-display text-xl tracking-[-0.02em]">{item.title}</h2>
            <p class="mt-2 font-serif text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <Dispatch />
</BaseLayout>
